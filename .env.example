# Copy to .env and edit. Every setting is optional — these are the defaults.
# All settings take the JOBHUNTER_ prefix.

JOBHUNTER_DB_URL=sqlite+pysqlite:///jobhunter.db
JOBHUNTER_CACHE_DIR=.cache

# Politeness. Raising requests_per_second or disabling robots is what gets your
# IP blocklisted; docs/compliance.md treats these as non-negotiable defaults.
JOBHUNTER_REQUESTS_PER_SECOND=1.0
JOBHUNTER_MAX_CONCURRENCY=5
JOBHUNTER_REQUEST_TIMEOUT=20.0
JOBHUNTER_MAX_RETRIES=3
JOBHUNTER_RESPECT_ROBOTS=true
JOBHUNTER_CACHE_TTL_SECONDS=21600
JOBHUNTER_RETRY_BACKOFF_BASE=2.0

# Identify the bot honestly, with a URL a site owner can visit to understand
# what it is and how to block it. Never impersonate a browser.
JOBHUNTER_USER_AGENT=JobHunterBot/0.1 (personal job search; +https://example.com/about-this-bot)

# SMTP verification is opt-in enrichment; the pipeline works fully without it.
# smtp_helo_host and smtp_mail_from MUST be a domain you actually control — a
# HELO that does not resolve is an instant reject on well-configured servers.
JOBHUNTER_VERIFY_EMAILS=false
JOBHUNTER_SMTP_HELO_HOST=example.com
JOBHUNTER_SMTP_MAIL_FROM=verify@example.com
JOBHUNTER_SMTP_TIMEOUT=10.0
JOBHUNTER_SMTP_DELAY_SECONDS=3.0

# Contact discovery
JOBHUNTER_ENABLE_PATTERN_GUESSING=true
JOBHUNTER_MAX_GUESSES_PER_DOMAIN=6
